# Base URL of the Saraha backend as seen by the browser.
# Default "/api" uses the Vite dev proxy (no CORS needed). In production set the real URL
# (the backend must then allow CORS for your frontend origin).
VITE_API_URL=/api
# Where the dev proxy forwards /api to:
VITE_PROXY_TARGET=http://localhost:3000

# Google Identity Services client ID (OAuth 2.0 Web client). Leave empty to disable Google sign-in.
VITE_GOOGLE_CLIENT_ID=
